{
    "version": 3,
    "configurePresets": [
        {
            "name": "mingw-clang-base",
            "hidden": true,
            "generator": "Ninja",
            "binaryDir": "${sourceDir}/out/build/${presetName}",
            "installDir": "${sourceDir}/out/install/${presetName}",
            "cacheVariables": {
                "CMAKE_C_COMPILER": "clang",
                "CMAKE_CXX_COMPILER": "clang++",
                "CMAKE_C_COMPILER_TARGET": "x86_64-w64-mingw32",
                "CMAKE_CXX_COMPILER_TARGET": "x86_64-w64-mingw32",
                "CMAKE_C_FLAGS": "-fuse-ld=lld",
                "CMAKE_CXX_FLAGS": "-fuse-ld=lld",
                "CMAKE_C_FLAGS_RELEASE": "-O3 -DNDEBUG",
                "CMAKE_CXX_FLAGS_RELEASE": "-O3 -DNDEBUG",
                "CMAKE_C_FLAGS_DEBUG": "-gdwarf-4 -g3 -O0 -fno-omit-frame-pointer",
                "CMAKE_CXX_FLAGS_DEBUG": "-gdwarf-4 -g3 -O0 -fno-omit-frame-pointer"
            },
            "condition": {
                "type": "equals",
                "lhs": "${hostSystemName}",
                "rhs": "Windows"
            }
        },
        {
            "name": "mingw-x64-debug",
            "displayName": "MinGW Clang x64 Debug",
            "inherits": "mingw-clang-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Debug"
            }
        },
        {
            "name": "mingw-x64-release",
            "displayName": "MinGW Clang x64 Release",
            "inherits": "mingw-clang-base",
            "cacheVariables": {
                "CMAKE_BUILD_TYPE": "Release"
            }
        }
    ]
}